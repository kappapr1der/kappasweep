<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>KappaSweep</AssemblyName>
    <Product>KappaSweep</Product>
    <Title>KappaSweep</Title>
    <Version>1.3.0</Version>
    <StartupObject>KappaSweepLauncher.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>assets\kappasweep.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PortableBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="KappaSweepPayload.zip" LogicalName="KappaSweepPayload.zip" />
  </ItemGroup>
</Project>
